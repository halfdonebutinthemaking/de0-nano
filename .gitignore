# Per-sample build outputs (everything Quartus generates lands here)
samples/*/built/

# Safety nets in case a stray build artefact leaks to the sample root
samples/*/db/
samples/*/incremental_db/
samples/*/output_files/
samples/*/*.rpt
samples/*/*.summary
samples/*/*.smsg
samples/*/*.done
samples/*/*.pin
samples/*/*.jdi
samples/*/*.qws
samples/*/*.sopcinfo
samples/*/*.sof
samples/*/*.sld
samples/*/*.pof
samples/*/*.jic
samples/*/*.rpd
samples/*/*.map
samples/*/*.svf
samples/*/*_assignment_defaults.qdf

# Multi-GB, licensed vendor blobs — never commit these
instructions/*.run
instructions/*.qdz
instructions/*.par
instructions/*.tar
instructions/_extracted/
# instructions/libccl_sqlite3.so is intentionally tracked (federunco patch)

.claude/
.obsidian/
.vscode/

# macOS
.DS_Store
